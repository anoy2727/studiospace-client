# URL of the deployed Express API (Render). Used by the Next.js rewrite at build time.
BACKEND_URL=http://localhost:5000
# Optional: Google sign-in (OAuth Web Client ID - same value as the server GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: imgbb key to enable image file upload in the studio form
NEXT_PUBLIC_IMGBB_KEY=
